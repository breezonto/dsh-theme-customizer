{
  "name": "@local/dsh-theme-customizer",
  "version": "1.0.0",
  "private": true,
  "description": "Theme customizer for the DeepSeek Harness Web GUI: wallpaper, wallpaper transparency, global and composer fonts, and accent colors.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "engines": {
    "dsh": "^0.2.3-alpha.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.20.0-alpha.1"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
